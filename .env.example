# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# The 9-dot unlock pattern. Dots are indexed 0-8, left-to-right, top-to-bottom:
#   0 1 2
#   3 4 5
#   6 7 8
# Minimum 4 dots. Example below draws an "L".
SECRET_PATTERN=0-3-6-7-8

# Random string used to sign the session cookie (HMAC-SHA256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Git-as-a-Database.
# Leave GITHUB_TOKEN blank to use the LOCAL filesystem driver (writes straight
# into ./data on your machine — perfect for local dev). Fill it in to commit
# through the GitHub API instead (required on Vercel: its filesystem is
# read-only).
# ---------------------------------------------------------------------------

# Fine-grained PAT. Repository access: only this repo.
# Permissions: "Contents: Read and write"  (nothing else is needed).
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=Capstone
GITHUB_BRANCH=main

# Optional: author shown on the commits the app creates.
GIT_COMMITTER_NAME=Capstone Console
GIT_COMMITTER_EMAIL=capstone-console@users.noreply.github.com
